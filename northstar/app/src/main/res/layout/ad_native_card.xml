<?xml version="1.0" encoding="utf-8"?>
<!-- Annuncio nativo nello stile Notte Neon. L'etichetta "Annuncio" è obbligatoria per AdMob. -->
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ad_card_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="15dp">

        <ImageView
            android:id="@+id/ad_icon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="13dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/ad_badge_bg"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:text="@string/ad_label"
                android:textColor="#B08CF7"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ad_headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#F1EEFC"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ad_body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#9B8FC7"
                android:textSize="11.5sp" />
        </LinearLayout>

        <Button
            android:id="@+id/ad_cta"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/ad_cta_bg"
            android:minWidth="0dp"
            android:paddingHorizontal="14dp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
